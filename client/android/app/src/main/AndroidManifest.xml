<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Committed on purpose. `flutter create` generates a vanilla manifest with
      NO package-visibility <queries> (so on Android 11+ url_launcher cannot see
      / open a browser) and NO custom-scheme intent-filter (so the OAuth redirect
      openidx://oauth-callback can't return to the app). Because `flutter create`
      does not overwrite existing files, this hand-written manifest wins.

      Package/applicationId is com.example.openidx_client, matching
      `flutter create` with project-name openidx_client; keep .MainActivity in sync.
    -->

    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Camera: the enroll screen can scan the console's QR code (mobile_scanner). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!--
      Android 11 (API 30) package visibility: without this, url_launcher's
      canLaunch/launchUrl for an https:// URL returns false because the app can't
      "see" any browser. This declares intent to open BROWSABLE VIEW/https.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
    </queries>

    <!--
      The engine's config directory is this app's filesDir, and three of the
      files in it are credentials: agent.json (the agent's auth token),
      user-tokens.json (the signed-in user's access token and their 30-day
      refresh token) and ziti-identity.json (the PRIVATE KEY and certificates
      that put this device on the ZTNA overlay).

      filesDir is in Android Auto Backup's default set. With no allowBackup
      attribute the platform default is TRUE, so all three were being uploaded
      to the user's Google Drive and were extractable with `adb backup`. The Go
      code writes them 0600, which is the whole protection on a Linux desktop
      and is inert here — inside the sandbox every file is already private to
      this UID, and a mode bit says nothing about what the backup agent copies
      out.

      allowBackup="false" stops cloud backup on every API level.
      dataExtractionRules is needed as well: from API 31 device-to-device
      transfer is governed separately and is ALLOWED by default, so
      allowBackup alone would still hand the identity to the next phone.

      agent-android (the managed-device APK) has carried allowBackup="false"
      since it was written; this app is the one that had it missing.
      scripts/check-mobile-secrets-at-rest.sh now fails the build if either
      loses it.
    -->
    <application
        android:label="OpenIDX"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Displays an Android View that continues showing the launch screen
                 Drawable until Flutter paints its first frame, then this is
                 replaced with the standard theme. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>

            <!-- Standard launcher intent-filter. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!--
              Custom-scheme deep link for the OAuth redirect. The server 302s to
              openidx://oauth-callback?code=…&state=…; this routes it back to the
              app, where app_links delivers it to the login flow. autoVerify is
              false because a custom scheme cannot be App-Links-verified.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="openidx" android:host="oauth-callback"/>
            </intent-filter>

            <!--
              QR-free enrollment: the console / an emailed link uses
              openidx://enroll?code=…&server=…. Tapping it on the phone opens the
              app, which prefills the code + server and enrolls in one tap — no QR
              scan needed. Same custom-scheme routing as oauth-callback above.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="openidx" android:host="enroll"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>
</manifest>
