# SDK-generated platform runner directories.
# These are materialized in CI (and locally) via `flutter create --platforms=... .`
# and are intentionally NOT committed here.
/android/
/ios/
/web/
/windows/
/linux/
/macos/

# EXCEPTION: the Android manifest IS committed. `flutter create` generates a
# vanilla manifest lacking the package-visibility <queries> (Android 11 browser
# open) and the openidx:// intent-filter (OAuth deep-link redirect); since
# `flutter create` won't overwrite an existing file, our committed one wins.
# Un-ignore each parent dir so git can track the file within the ignored tree.
#
# SO IS res/xml/data_extraction_rules.xml, and it needs its own chain. The
# manifest references it (@xml/data_extraction_rules) to deny device-to-device
# transfer of the engine's tokens and ZTNA key; a manifest naming a resource
# that is not in the repository is an AAPT link error on a clean checkout, so
# these two files are committed together or neither works. Adding a file under
# this tree without extending the chain looks fine locally — it exists on disk —
# and disappears the moment anyone else clones. `git add -A` says nothing.
!/android/
/android/*
!/android/app/
/android/app/*
!/android/app/src/
/android/app/src/*
!/android/app/src/main/
/android/app/src/main/*
!/android/app/src/main/AndroidManifest.xml
!/android/app/src/main/res/
/android/app/src/main/res/*
!/android/app/src/main/res/xml/
/android/app/src/main/res/xml/*
!/android/app/src/main/res/xml/data_extraction_rules.xml

# Bundled sidecar binary staged next to the app during packaging.
/assets/bin/
openidx-agent
openidx-agent.exe
