[Unit]
Description=OpenIDX Postgres restore-verify (restore latest dump into a scratch DB)
Documentation=file:deployments/scripts/pg-restore-verify.sh
Wants=network-online.target

[Service]
Type=oneshot
# Same optional settings file as oidx-pg-backup.service. This unit verifies
# the LOCAL copy; the off-box drill is `pg-restore-verify.sh --from-offbox`
# (deployments/scripts/README.md).
EnvironmentFile=-%h/.config/oidx/backup.env
ExecStart=%h/oidx-runtime/scripts/pg-restore-verify.sh
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=1800
