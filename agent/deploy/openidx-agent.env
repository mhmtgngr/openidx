# OpenIDX Agent environment (read by openidx-agent.service).
# Packaged as a config file: local edits survive upgrades.
# OPENIDX_SERVER_URL=https://openidx.example.com
# Egress proxy (the agent also honours proxy_url in agent.json; PAC is not
# evaluated):
# HTTPS_PROXY=http://proxy.corp:3128
# NO_PROXY=localhost,127.0.0.1,.corp
OPENIDX_CONFIG_DIR=/var/lib/openidx-agent
