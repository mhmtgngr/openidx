<?xml version="1.0" encoding="UTF-8"?>
<!--
  OpenIDX Windows client MSI (WiX v4/v5).

  Build:
    wix build agent/packaging/wix/OpenIDX.wxs \
      -d Version=1.0.0 -d ExePath=dist/openidx-agent.exe \
      -arch x64 -o dist/OpenIDX.msi

  Installs the single openidx-agent.exe, registers + starts the Windows service
  (posture loop), and launches the tray at user login. Silent/GPO/Intune:
    msiexec /i OpenIDX.msi /qn SERVER_URL=https://openidx.example.com ENROLL_TOKEN=...
  ENROLL_TOKEN triggers a device enrollment during install and upgrade
  (best-effort, retried by the service). Optional: TUNNEL_ENABLED, SERVER_CA,
  PROXY_URL, LOG_LEVEL, KEEP_ENROLL_TOKEN (default 1). Intune detection:
  HKLM\SOFTWARE\OpenIDX\Agent Version. See docs/runbooks/agent-intune.md.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="OpenIDX Agent"
           Manufacturer="OpenIDX"
           Version="$(var.Version)"
           UpgradeCode="6f4a1e2c-2b7d-4b1a-9c3e-0a1b2c3d4e5f"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of OpenIDX Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Branding: the multi-resolution shield icon, shown in Add/Remove
         Programs and on the Start-Menu shortcut. Path is relative to this .wxs. -->
    <Icon Id="OpenIDXIcon" SourceFile="$(sys.SOURCEFILEDIR)..\..\assets\openidx.ico" />
    <Property Id="ARPPRODUCTICON" Value="OpenIDXIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/mhmtgngr/openidx" />

    <!-- Public properties usable from a silent msiexec command line. -->
    <Property Id="SERVER_URL" Secure="yes" />
    <Property Id="ENROLL_TOKEN" Secure="yes" Hidden="yes" />
    <!-- TUNNEL_ENABLED=1|0 turns the bundled tunnel on or off for this device
         (empty leaves it as it is). SERVER_CA is the path of a PEM CA file to
         trust for the server. PROXY_URL is an explicit http(s) proxy (empty:
         system settings). LOG_LEVEL is debug|info|warn|error.
         KEEP_ENROLL_TOKEN=1 (the default) seals the fleet token in the config
         directory so the service finishes an enrolment that failed here (no
         network yet) with backoff; pass KEEP_ENROLL_TOKEN=0 to keep nothing. -->
    <Property Id="TUNNEL_ENABLED" Secure="yes" />
    <Property Id="SERVER_CA" Secure="yes" />
    <Property Id="PROXY_URL" Secure="yes" Hidden="yes" />
    <Property Id="LOG_LEVEL" Secure="yes" />
    <Property Id="KEEP_ENROLL_TOKEN" Secure="yes" Value="1" />
    <!-- The enrol action's command line carries ENROLL_TOKEN. Hidden keeps
         it, and the CustomActionData built from it, out of /l*v logs. -->
    <Property Id="EnrollDevice" Hidden="yes" />

    <!-- Read back what an earlier install recorded, so an upgrade without
         SERVER_URL on its command line keeps the server it had, and an
         uninstall knows the data folder to remove. -->
    <Property Id="SAVED_SERVER_URL">
      <RegistrySearch Id="SavedServerUrl" Root="HKLM" Key="SOFTWARE\OpenIDX\Agent"
                      Name="ServerUrl" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="AGENTDATADIR">
      <RegistrySearch Id="SavedDataDir" Root="HKLM" Key="SOFTWARE\OpenIDX\Agent"
                      Name="DataDir" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="SERVER_URL" Value="[SAVED_SERVER_URL]" After="AppSearch"
                 Sequence="both" Condition="NOT SERVER_URL AND SAVED_SERVER_URL" />
    <!-- The update manifest URL persisted at enroll so the service
         self-updates. A release build defaults it to the agent release channel
         (…/releases/download/agent-latest/latest.json); pass
         UPDATE_MANIFEST_URL="" to turn self-update off, or a mirror's URL. -->
    <?ifdef DefaultManifestURL ?>
    <Property Id="UPDATE_MANIFEST_URL" Secure="yes" Value="$(var.DefaultManifestURL)" />
    <?else?>
    <Property Id="UPDATE_MANIFEST_URL" Secure="yes" />
    <?endif?>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="OpenIDX" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutFolder" Name="OpenIDX" />
    </StandardDirectory>

    <ComponentGroup Id="AppComponents" Directory="INSTALLFOLDER">
      <!-- The agent binary + the Windows service definition. -->
      <Component Id="AgentExe">
        <File Id="AgentExeFile" Name="openidx-agent.exe" Source="$(var.ExePath)" KeyPath="yes" />
        <ServiceInstall Id="OpenIDXAgentSvc"
                        Name="OpenIDXAgent"
                        DisplayName="OpenIDX Agent"
                        Description="OpenIDX device-trust agent (enrollment, posture, OpenZiti connectivity)."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Arguments="service run --config-dir &quot;[CommonAppDataFolder]OpenIDX\agent&quot;">
          <!-- A service that stops is a device with no posture loop and no
               tray; Windows restarts it ten seconds after each failure, and
               the failure count resets daily so a flapping service does not
               give up after three. Without this the Service Control Manager
               left it stopped (sc qfailure showed no action). -->
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="10"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="OpenIDXAgentSvcCtl"
                        Name="OpenIDXAgent"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <!-- Optional: the libvpx runtime DLL that the screen-share (VP8) build
           links against. Included only when the build passes -d VpxDll=<path>
           (the CI screenshare build does; the pure-Go build omits it). -->
      <?ifdef VpxDll ?>
      <Component Id="VpxRuntime">
        <File Id="VpxDllFile" Source="$(var.VpxDll)" KeyPath="yes" />
      </Component>
      <?endif?>

      <!-- Optional: the MinGW pthread runtime DLL. The CGO/MinGW screen-share
           build normally static-links this (see windows-client-build.yml), but
           when it is shipped as a fallback the build passes -d PthreadDll=<path>
           so a clean box without a MinGW toolchain can still launch the exe
           (missing libwinpthread-1.dll -> 0xC0000135 -> service 1920 -> 1603). -->
      <?ifdef PthreadDll ?>
      <Component Id="PthreadRuntime">
        <File Id="PthreadDllFile" Source="$(var.PthreadDll)" KeyPath="yes" />
      </Component>
      <?endif?>

      <!-- Optional: the bundled OpenZiti tunneler and the Wintun driver DLL it
           creates its adapter with, from the pinned ziti-edge-tunnel release
           (windows-client-build.yml verifies its SHA-256 before passing
           -d ZitiTunnelExe=<path> -d WintunDll=<path>). They sit beside
           openidx-agent.exe, where the agent looks first
           (internal/tunnel/locate.go). The agent service runs the tunneler as
           its child, only when the tunnel is enabled; nothing here registers
           it as a service of its own. See docs/AGENT-TUNNEL.md. -->
      <?ifdef ZitiTunnelExe ?>
      <Component Id="ZitiTunnel">
        <File Id="ZitiTunnelExeFile" Name="ziti-edge-tunnel.exe" Source="$(var.ZitiTunnelExe)" KeyPath="yes" />
      </Component>
      <Component Id="WintunRuntime">
        <File Id="WintunDllFile" Name="wintun.dll" Source="$(var.WintunDll)" KeyPath="yes" />
      </Component>
      <?endif?>

      <!-- Intune / SCCM detection rule: HKLM\SOFTWARE\OpenIDX\Agent Version.
           InstallDir and ServerUrl are for support; DataDir drives the
           uninstall cleanup below. -->
      <Component Id="AgentRegistry">
        <RegistryKey Root="HKLM" Key="SOFTWARE\OpenIDX\Agent">
          <RegistryValue Name="Version" Type="string" Value="$(var.Version)" KeyPath="yes" />
          <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
          <RegistryValue Name="ServerUrl" Type="string" Value="[SERVER_URL]" />
          <RegistryValue Name="DataDir" Type="string" Value="[CommonAppDataFolder]OpenIDX\agent" />
        </RegistryKey>
        <!-- %ProgramData%\OpenIDX\agent (agent.json, identity, sealed token)
             goes with an uninstall, not with the uninstall half of an upgrade,
             which must keep the enrolment. -->
        <util:RemoveFolderEx Id="RemoveAgentData" On="uninstall" Property="AGENTDATADIR"
                             Condition="NOT UPGRADINGPRODUCTCODE" />
      </Component>

      <!-- Launch the tray for the interactive user at login. -->
      <Component Id="TrayAutostart">
        <RegistryValue Root="HKMU"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="OpenIDXTray"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]openidx-agent.exe&quot; tray --autostart"
                       KeyPath="yes" />
      </Component>

      <!-- The openidx: URL scheme, so a scanned QR or a clicked enrolment link
           (openidx://enroll?code=...&amp;server=...) starts the agent, which asks
           for administrator approval and enrols the device. packaging/DEEPLINK.md
           describes the flow; the agent's main.go rewrites the link into the
           enroll command with its code and server flags. (No double hyphen may
           appear inside an XML comment, hence the wording.) -->
      <Component Id="UrlSchemeOpenidx">
        <RegistryKey Root="HKCR" Key="openidx">
          <RegistryValue Type="string" Value="URL:OpenIDX Protocol" KeyPath="yes" />
          <RegistryValue Name="URL Protocol" Type="string" Value="" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]openidx-agent.exe&quot;,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]openidx-agent.exe&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>

      <!-- Start-Menu shortcut to (re)launch the tray, carrying the app icon. -->
      <Component Id="StartMenuShortcut" Directory="AppShortcutFolder">
        <Shortcut Id="TrayShortcut"
                  Name="OpenIDX"
                  Description="Open the OpenIDX tray (sign in, connections, status)"
                  Target="[INSTALLFOLDER]openidx-agent.exe"
                  Arguments="tray"
                  Icon="OpenIDXIcon"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveAppShortcutFolder" On="uninstall" />
        <RegistryValue Root="HKMU"
                       Key="Software\OpenIDX\Agent"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="OpenIDX Agent" Level="1">
      <ComponentGroupRef Id="AppComponents" />
    </Feature>

    <!--
      Silent enroll-at-install: when SERVER_URL + ENROLL_TOKEN are supplied,
      run `openidx-agent enroll` after files are laid down. Use a REUSABLE
      bootstrap token (see the reusable flag on /agent/tokens) so one token
      serves the whole fleet:
        msiexec /i OpenIDX.msi /qn SERVER_URL=https://openidx.example.com ENROLL_TOKEN=<REUSABLE>
      Deferred + no-impersonate (runs as LocalSystem, same account as the
      service). Return=ignore so a transient enroll failure never blocks the
      install: with KEEP_ENROLL_TOKEN=1 the service retries (1m, 5m, 15m,
      hourly). It runs on an upgrade too, so a new SERVER_URL is written; it
      is skipped only on uninstall. HideTarget plus the Hidden properties keep
      the token out of a verbose log.
    -->
    <SetProperty Id="EnrollDevice"
                 Sequence="execute"
                 Before="EnrollDevice"
                 Value="&quot;[INSTALLFOLDER]openidx-agent.exe&quot; enroll --server &quot;[SERVER_URL]&quot; --token &quot;[ENROLL_TOKEN]&quot; --manifest-url &quot;[UPDATE_MANIFEST_URL]&quot; --keep-token=[KEEP_ENROLL_TOKEN] --tunnel &quot;[TUNNEL_ENABLED]&quot; --proxy-url &quot;[PROXY_URL]&quot; --server-ca &quot;[SERVER_CA]&quot; --log-level &quot;[LOG_LEVEL]&quot; --config-dir &quot;[CommonAppDataFolder]OpenIDX\agent&quot;"
                 Condition="SERVER_URL AND ENROLL_TOKEN" />
    <CustomAction Id="EnrollDevice"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  HideTarget="yes"
                  Return="ignore" />

    <!-- The tray is not launched from here. The service starts it in every
         signed-in session within seconds of starting (winservice/traylaunch),
         which covers an interactive install, a silent or GPO install and an
         upgrade alike, and the Run key above starts it at each sign-in. The
         LaunchTray action that used to sit here never ran: WixQuietExec read
         no command line (0x80070057), it would have blocked the install on a
         tray that never exits, and an upgrade skipped it. -->

    <!-- Tunnel cleanup on uninstall. The service stops first (its job
         object kills ziti-edge-tunnel, which on Windows cannot be asked to
         stop), then this removes the NRPT rules and Wintun adapter the killed
         tunneler leaves (docs/AGENT-TUNNEL.md, "Not yet verified"). It runs
         before RemoveFiles, while the exe is still there. -->
    <SetProperty Id="TunnelCleanup"
                 Sequence="execute"
                 Before="TunnelCleanup"
                 Value="&quot;[INSTALLFOLDER]openidx-agent.exe&quot; tunnel-cleanup"
                 Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <CustomAction Id="TunnelCleanup"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="TunnelCleanup" After="StopServices"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="EnrollDevice" After="InstallServices"
              Condition="SERVER_URL AND ENROLL_TOKEN AND NOT (REMOVE~=&quot;ALL&quot;)" />
    </InstallExecuteSequence>
  </Package>
</Wix>
