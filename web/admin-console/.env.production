# Production build settings for the OpenIDX admin console.
#
# A built console talks to the origin it is served from: the edge in front of
# it routes /api, /oauth and /.well-known to the services. Leave the two URLs
# below unset unless the API or the OAuth service live on another origin.
# Site-specific values go in .env.production.local, which git ignores.
#
# VITE_API_URL=https://idp.example.com
# VITE_OAUTH_URL=https://idp.example.com

# OAuth/OIDC Configuration
VITE_OAUTH_CLIENT_ID=admin-console

# Application Configuration
VITE_APP_NAME=OpenIDX
VITE_APP_ENV=production

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_AUDIT_LOG=true
VITE_ENABLE_MFA=true

# Session Configuration
VITE_SESSION_TIMEOUT_MINUTES=60
VITE_MAX_CONCURRENT_SESSIONS=5

# Branding
VITE_PRIMARY_COLOR=#3b82f6
