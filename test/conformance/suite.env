# The OpenID Foundation conformance suite release the nightly run uses
# (.github/workflows/oidc-conformance.yml).
#
# The runner scripts (scripts/run-test-plan.py and its helpers) are cloned at
# this tag, and the clone is refused unless it is exactly this commit.
# compose.yml pins the same release's server and nginx images by digest.
# Bump all four values together, in one change, and read the release notes:
# a new suite release can add or tighten checks, so a changed result may come
# from the suite rather than from OpenIDX.
CONFORMANCE_SUITE_TAG=release-v5.3.1
CONFORMANCE_SUITE_COMMIT=440eec8bac7b12b7389d7ca9cbc459b53507a443
