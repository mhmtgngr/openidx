{
  "alias": "openidx-basic",
  "description": "OpenIDX nightly: Basic OP and Config OP, static clients",
  "server": {
    "discoveryUrl": "@@OP_ISSUER@@/.well-known/openid-configuration"
  },
  "client": {
    "client_id": "@@CLIENT_ID@@",
    "client_secret": "@@CLIENT_SECRET@@"
  },
  "client2": {
    "client_id": "@@CLIENT2_ID@@",
    "client_secret": "@@CLIENT2_SECRET@@"
  },
  "client_secret_post": {
    "client_id": "@@CLIENT_ID@@",
    "client_secret": "@@CLIENT_SECRET@@"
  },
  "options": {
    "browsercontrol_css_enable": false
  },
  "browser": [
    {
      "comment": "Every authorization request: sign in on the test login page, or approve consent when OpenIDX resumes an existing browser session, then wait for the suite's callback page.",
      "match": "@@OP_ISSUER@@/oauth/authorize*",
      "tasks": [
        {
          "task": "Approve consent (session resumed)",
          "optional": true,
          "match": "@@OP_ISSUER@@/login?*resume=1*",
          "commands": [
            ["wait", "id", "approve", 10],
            ["click", "id", "approve"],
            ["wait", "contains", "@@SUITE_URL@@/test/a/", 10]
          ]
        },
        {
          "task": "Login",
          "optional": true,
          "match": "@@OP_ISSUER@@/login?*",
          "commands": [
            ["wait", "id", "signin", 10, "Sign in", "update-image-placeholder-optional"],
            ["text", "id", "username", "@@USERNAME@@"],
            ["text", "id", "password", "@@PASSWORD@@"],
            ["click", "id", "signin"],
            ["wait", "contains", "@@SUITE_URL@@/test/a/", 15]
          ]
        },
        {
          "task": "Verify Complete",
          "match": "@@SUITE_URL@@/test/a/*/callback*",
          "commands": [
            ["wait", "id", "submission_complete", 10]
          ]
        }
      ]
    }
  ],
  "override": {
    "oidcc-ensure-registered-redirect-uri": {
      "browser": [
        {
          "comment": "OpenIDX answers an unregistered redirect_uri with a 400 JSON error at the authorization endpoint. The error page fills the screenshot placeholder; the suite fails the module if OpenIDX redirects instead.",
          "match": "@@OP_ISSUER@@/oauth/authorize*",
          "tasks": [
            {
              "task": "Expect the redirect_uri error page",
              "match": "@@OP_ISSUER@@/oauth/authorize*",
              "commands": [
                ["wait", "xpath", "//*", 10, "invalid_request", "update-image-placeholder"]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-ensure-request-object-with-redirect-uri": {
      "browser": [
        {
          "comment": "Two outcomes pass this module: an error page for the invalid redirect_uri outside the request object, or a completed login that used the redirect_uri inside it. Either path is scripted; the suite judges which one happened.",
          "match": "@@OP_ISSUER@@/oauth/authorize*",
          "tasks": [
            {
              "task": "Expect the redirect_uri error page",
              "optional": true,
              "match": "@@OP_ISSUER@@/oauth/authorize*",
              "commands": [
                ["wait", "xpath", "//*", 10, "invalid_request", "update-image-placeholder"]
              ]
            },
            {
              "task": "Login",
              "optional": true,
              "match": "@@OP_ISSUER@@/login?*",
              "commands": [
                ["wait", "id", "signin", 10, "Sign in"],
                ["text", "id", "username", "@@USERNAME@@"],
                ["text", "id", "password", "@@PASSWORD@@"],
                ["click", "id", "signin"],
                ["wait", "contains", "@@SUITE_URL@@/test/a/", 15]
              ]
            },
            {
              "task": "Verify Complete",
              "optional": true,
              "match": "@@SUITE_URL@@/test/a/*/callback*",
              "commands": [
                ["wait", "id", "submission_complete", 10]
              ]
            }
          ]
        }
      ]
    }
  }
}
